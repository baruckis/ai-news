# Copy this file to deploy/.env on the server and fill in real values.
# deploy/.env is gitignored — never commit real keys.

# Required: NewsData.io API key (https://newsdata.io/).
NEWSDATA_KEY=

# Optional: GNews API key (https://gnews.io/), used as a fallback when NewsData
# returns an error or hits its quota.
GNEWS_KEY=

# News lookback window, e.g. 168h (one week) or 24h (one day). Defaults to 168h
# when this line is removed. NOTE: NewsData.io's `timeframe` parameter requires a
# PAID plan — on the free tier leave the value EMPTY (`NEWS_TIMEFRAME=`) so the
# BFF omits the parameter and serves the latest news instead.
NEWS_TIMEFRAME=168h
