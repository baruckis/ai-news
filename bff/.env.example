# Copy this file to bff/.env and fill in real values.
# bff/.env is gitignored — never commit real keys.

# Required: NewsData.io API key (https://newsdata.io/).
NEWSDATA_KEY=

# Optional: GNews API key (https://gnews.io/), used as a fallback when NewsData
# returns an error or hits its quota.
GNEWS_KEY=

# Optional: news lookback window, e.g. 168h (one week) or 24h (a day).
# NOTE: NewsData.io's `timeframe` parameter requires a PAID plan. Leave this unset on
# the free tier (the BFF then returns the latest news and omits the parameter).
# NEWS_TIMEFRAME=168h

# Optional: HTTP port the BFF listens on. Default 8080.
PORT=8080
