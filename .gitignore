# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/
# …but the committed baseline profile lives under app/src/release — keep that source set.
!app/src/release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, secrets, etc.) — never commit
local.properties

# Environment files — never commit
.env
.env.*
!.env.example

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio / IntelliJ
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Keystore files
*.jks
*.keystore

# Kotlin
.kotlin/

# macOS
.DS_Store

# Local planning notes and agent guide — personal, never push to remote
_planning/
CLAUDE.md

# User documentation folder — personal, never push to remote
_docs/
